# ============================================================
# 秋招 AI 面试陪练平台 —— 后端环境变量
# 复制为 .env 后按需修改。不要提交 .env 到版本库。
# ============================================================

APP_ENV=development
APP_NAME=秋招 AI 面试陪练平台
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 数据库 ----
# 开发（默认，零配置）：
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 生产 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/interview

# ---- LLM（OpenAI 兼容协议）----
# LLM_API_KEY 留空 => 自动降级为内置 Mock 面试官，全流程仍可跑通
LLM_API_KEY=
# DeepSeek:  https://api.deepseek.com/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 评分/报告可用更便宜的模型，留空则复用 LLM_MODEL
LLM_MODEL_EVAL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- 上传 ----
UPLOAD_MAX_MB=5

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
